#!/usr/bin/make -f
export PYTHONWARNINGS=ignore::DeprecationWarning

%:
	dh $@

override_dh_auto_build:
	@echo "pure Python and POSIX shell; nothing to compile"

override_dh_auto_test:
	@echo "tests are run by the maintainer, not during package build"

override_dh_auto_install:
	install -d debian/winpe-terminal/usr/bin
	install -m 0755 main_program/winpe_terminal debian/winpe-terminal/usr/bin/winpe_terminal
	install -d debian/winpe-terminal/usr/lib/winpe-terminal/wpt
	install -m 0644 main_program/wpt/*.py debian/winpe-terminal/usr/lib/winpe-terminal/wpt/
	install -d debian/winpe-terminal/usr/lib/winpe-terminal/tools
	install -m 0755 main_program/tools/build_winpe.py debian/winpe-terminal/usr/lib/winpe-terminal/tools/
	install -d debian/winpe-terminal/usr/lib/winpe-terminal/guest
	install -m 0644 main_program/guest/startnet.cmd debian/winpe-terminal/usr/lib/winpe-terminal/guest/
	install -d debian/winpe-terminal/etc/winpe-terminal
	install -m 0644 debian/config.json debian/winpe-terminal/etc/winpe-terminal/config.json
	install -d debian/winpe-terminal/usr/share/doc/winpe-terminal
	cp -a document/for_user/readme.txt document/for_user/protocol \
	      document/for_user/technique_parts document/for_user/licenses \
	      debian/winpe-terminal/usr/share/doc/winpe-terminal/

override_dh_installman:
	install -d debian/winpe-terminal/usr/share/man/man8
	install -m 0644 debian/winpe_terminal.1 debian/winpe-terminal/usr/share/man/man8/winpe_terminal.8

override_dh_compress:
	dh_compress -X.txt -X.md
